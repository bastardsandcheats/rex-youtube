+// Feed file labels can be .mp4 even when the source serves an adaptive manifest.
+// Native demuxers must receive its real MIME type to recognize HLS/DASH safely.
+fn manifest_content_type(header: Option<&str>) -> Option<&str> {
+    let kind = header?.split(';').next()?.trim();
+    matches!(kind.to_ascii_lowercase().as_str(),
+        "application/vnd.apple.mpegurl" | "application/x-mpegurl" |
+        "audio/mpegurl" | "audio/x-mpegurl" | "application/dash+xml").then_some(kind)
+}
+#[test]
+fn source_manifest_mime_is_preserved_but_file_mime_is_not_overridden() {
+    assert_eq!(manifest_content_type(Some("application/vnd.apple.mpegurl; charset=utf-8")), Some("application/vnd.apple.mpegurl"));
+    assert_eq!(manifest_content_type(Some("Application/Dash+Xml")), Some("Application/Dash+Xml"));
+    assert_eq!(manifest_content_type(Some("video/mp4")), None);
+    assert_eq!(manifest_content_type(Some("text/html")), None);
+    assert_eq!(manifest_content_type(None), None);
+}
